# Postgres connection string (Neon, Supabase, local, ...)
DATABASE_URL=postgresql://user:password@host:5432/database

# Any long random string. Changing it invalidates admin sessions.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 — see README. Leave these empty to fall back to local storage.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public origin of the bucket: the *.r2.dev development URL today, the custom
# media domain once it is connected. No trailing slash.
R2_PUBLIC_URL=

# Scheduled publishing. The jobs queue is driven by a cron request to
# /api/payload-jobs/run; set the same value in Vercel so its Cron requests send
# `Authorization: Bearer $CRON_SECRET`. Any long random string works.
CRON_SECRET=

# Set to true only on a long-lived Node server (Docker/VPS). Payload will then
# run the job queue itself every minute instead of waiting for an external cron.
# Leave unset on Vercel - serverless timers are killed after each request.
PAYLOAD_JOBS_AUTORUN=
